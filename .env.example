# Jira
JIRA_BASE_URL=https://jira.company.com
JIRA_USERNAME=
# Jira project key for defects (e.g. BDR). Derived from the project name if empty.
JIRA_PROJECT=
# auto = use the REST API when a token is set; browser = always drive the Jira UI
JIRA_MODE=auto
# Prefer `python setup.py`, which stores secrets in the OS credential store instead of this file.
JIRA_PAT=
# Path to a corporate CA bundle if Jira uses an internal certificate authority
JIRA_CA_BUNDLE=

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
