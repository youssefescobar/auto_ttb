{
  "manifest_version": 3,
  "name": "Auto TTB",
  "version": "0.1.0",
  "description": "Run Jira test executions from a side panel: pass/fail test cases, collect screenshots, export the Proof of Testing document.",
  "action": {
    "default_title": "Open Auto TTB"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture the visible tab into the open test case"
    }
  }
}
